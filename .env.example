# Futurematch / aileadz - environment variables
# Production runs on the VPS under ServerHoster (set these on the web service AND on
# the worker service: see docs/runbooks/DEPLOY.md and JOB_RUNNER.md). Nothing secret
# belongs in git: copy this file to .env for local work only.

# ============================== Core ==========================================
# Flask session signing key. REQUIRED in production (generate 64+ random bytes).
# Rotating it logs everybody out.
SECRET_KEY=
# Public base URL, used in e-mail links (order status, invite, reset).
APP_BASE_URL=https://app.example.dk
# production | staging (labels errors in Sentry)
APP_ENV=production
# 1 = sandbox/test mode: relaxes prod-only guards. NEVER set in production.
# SANDBOX=1

# ============================== Database ======================================
# ServerHoster injects DATABASE_URL for the linked MySQL. MYSQL_* overrides it.
DATABASE_URL=
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=
# Local dev through the SSH tunnel (run.py main()): SSH_HOST, SSH_USER, SSH_PASSWORD or SSH_PKEY

# ============================== E-mail (required for any mail to leave) ========
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
# MAIL_USE_SSL=1 (port 465) instead of TLS
MAIL_USERNAME=
MAIL_PASSWORD=
# From address; falls back to MAIL_USERNAME. Verify it with "Send test-mail" under
# Admin -> Systemstatus after every change.
MAIL_DEFAULT_SENDER=

# ============================== Background worker =============================
# The in-request job runner is the default so a fresh deploy still sends mail and
# webhooks. Once the dedicated worker service (python drain_worker.py --loop) runs,
# set this to 0 on the WEB service so visitors never pay for background work.
SCHEDULER_OPPORTUNISTIC=1
# Seconds between worker passes (worker service only)
OUTBOX_DRAIN_INTERVAL=60

# ============================== Observability =================================
# json = one JSON object per log line with the request id
LOG_FORMAT=
# Error tracking (optional): create a Sentry project and paste the DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Shared cache across workers (optional; falls back to in-process if unreachable)
REDIS_URL=

# ============================== Support page ==================================
SUPPORT_EMAIL=support@futurematch.dk
# Shown only when set (the page never promises a phone line you do not staff)
SUPPORT_PHONE=
SUPPORT_HOURS=
SUPPORT_SLA=

# ============================== Catalog =======================================
SHOPIFY_STORE_URL=futurematch.dk
# Shopify admin token for the scheduled catalog sync (see docs/USER_ACTIONS_PART_B.md).
# NEVER commit a token.
SHOPIFY_ADMIN_TOKEN=
# Shopify shop domain for the sync (e.g. mystore.myshopify.com) and optional path to the catalog JSON.
SHOPIFY_STORE=
CATALOG_SOURCE_FILE=

# ============================== SSO / secrets =================================
# Fernet key for SSO client secrets (falls back to a key derived from SECRET_KEY)
SSO_FERNET_KEY=

# ============================== AI ============================================

# OPENAI_API_KEY is required in EVERY configuration, including AI_PROVIDER=anthropic:
# embeddings / RAG retrieval have no Anthropic equivalent and the shipped catalog
# index is built with text-embedding-3-small.
OPENAI_API_KEY=

# --- AI provider toggle -------------------------------------------------------
# openai | anthropic | anthropic_shadow  (anthropic_shadow serves OpenAI and runs
# a sampled tool-less Claude comparison in the background). An admin can override
# this at runtime from /admin/ai-settings without a restart; the DB value wins
# over this env var. Only needed when AI_PROVIDER is anthropic or anthropic_shadow:
AI_PROVIDER=openai
ANTHROPIC_API_KEY=

# Both API keys above can instead be set from /admin/ai-settings, where they are
# stored Fernet-encrypted in the ai_settings database and take precedence over
# these env vars. AI_SECRET_KEY is the encryption key for that storage: generate
# one with
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it the app falls back to deriving a key from SECRET_KEY (weaker, and
# rotating SECRET_KEY orphans stored keys); with neither set, the admin UI
# refuses to store a key rather than writing it unencrypted.
AI_SECRET_KEY=

# Models
AI_MAIN_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
ANTHROPIC_MAIN_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
AI_RUNTIME=responses

# Claude-specific tuning (ignored when AI_PROVIDER=openai)
# Thinking tokens are charged against max_tokens and adaptive thinking is on by
# default, so the OpenAI tool-turn cap (320) is raised to this floor on Claude —
# otherwise a tool turn stops at max_tokens before emitting a tool_use block.
ANTHROPIC_MIN_MAX_TOKENS=4096
# Floor for ANSWER turns. Reasoning over long tool output (course search,
# profile analysis) spends thousands of thinking tokens before the first visible
# token, so AI_MAX_OUTPUT_TOKENS is far too tight on Claude and the answer stops
# mid-sentence. A ceiling is not a charge — only generated tokens are billed.
ANTHROPIC_ANSWER_MAX_TOKENS=16000
# output_config.effort replaces temperature (removed on current Claude models).
# Leave empty for the built-in tiering: low on tool turns / fast tier, high on
# main-tier final answers.
ANTHROPIC_EFFORT=
AI_ANTHROPIC_TIMEOUT_SECONDS=40
AI_ANTHROPIC_MAX_RETRIES=1
# Fraction of turns mirrored to Claude when AI_PROVIDER=anthropic_shadow.
AI_SHADOW_SAMPLE_RATE=0.1

# Token budgets (keep under OpenAI org TPM limit, e.g. 30000)
AI_MAX_INPUT_TOKENS=36000
AI_TPM_BUDGET=42000
# Per-turn system context (profile, memories, playbooks) is fitted by priority
# into this many tokens (ai_context_layers.py). 0/false on AI_CONTEXT_ASSEMBLER
# restores the legacy flat 1800-char cut for one release.
AI_CONTEXT_MAX_TOKENS=10000
AI_CONTEXT_ASSEMBLER=1
AI_STEERING_PLACEMENT=trailing
AI_MAX_OUTPUT_TOKENS=450
AI_MAX_TOOL_ITERATIONS=3
# Tool-deciding turns pin a low temperature for deterministic tool selection
# (empty value = use the API default). Token estimator chars/token divisor is
# tunable for Danish (legacy default 4.0).
AI_TOOL_TURN_TEMPERATURE=0.2
AI_TOKEN_CHARS_PER_TOKEN=3.5
# Optional token/recall tuning (default off — enable after an eval baseline confirms no regression)
AI_TRIM_TOOL_DESCRIPTIONS=off
AI_GROUNDING_DECOMPOUND=off

# Resilience
AI_RATE_LIMIT_RETRY_SECONDS=2.5
AI_RATE_LIMIT_COOLDOWN_SECONDS=90
AI_OPENAI_TIMEOUT_SECONDS=40

# Context
AI_FEW_SHOT=compact
AI_SUMMARY_MODE=rules
AI_TOOL_ROUTER_V2=1

# AI Tooler 2 — platform-control tools + confirm/progress UI (master kill-switch, default off)
AI_TOOLER2=off
# Live tool progress/finish events (existing) and final-answer capture (existing)
AI_LIVE_TOOL_EVENTS=1
AI_CAPTURE_FINAL=1

# RAG / embeddings
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1024
AI_RAG_CROSS_ENCODER=auto
AI_RERANK_MAX_CANDIDATES=4

# Observability (optional)
AI_TRACE_SAMPLE_RATE=1
AI_WARMUP_ON_IMPORT=1

# Re-index note: after switching AI_EMBEDDING_MODEL, run app1/build_index.py once and verify sample queries.
