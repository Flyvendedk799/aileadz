# Futurematch / aileadz - environment variables
# Production runs on the VPS under ServerHoster (set these on the web service AND on
# the worker service: see docs/runbooks/DEPLOY.md and JOB_RUNNER.md). Nothing secret
# belongs in git: copy this file to .env for local work only (wsgi.py, run_sandbox.py
# and app1/build_index.py load .env without overriding variables already in the
# process environment). Uncommented lines are the recommended production values;
# commented lines are optional and show the code default.

# ============================== Core ==========================================
# Flask session signing key. REQUIRED in production: the app refuses to boot without
# a real value (run.py resolve_secret_key). Generate 32+ random bytes:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating it logs everybody out and orphans keys derived from it: see
# docs/runbooks/SECRET_ROTATION.md.
SECRET_KEY=
# Public base URL, used in e-mail links (order status, invite, reset).
APP_BASE_URL=https://app.example.dk
# production | staging (labels errors in Sentry)
APP_ENV=production
# 1 = sandbox/test mode: relaxes prod-only guards (SECRET_KEY, secure cookies, HSTS,
# CSRF). NEVER set in production.
# SANDBOX=1
# 301 www.<host> -> <host> in wsgi.py (default 1; 0 disables)
# CANONICAL_WWW_REDIRECT=1
# Global request body cap in MB (default 26)
# MAX_CONTENT_LENGTH_MB=26
# Cache-Control max-age for worker-served /static (default 31536000)
# STATIC_MAX_AGE_SECONDS=31536000

# ============================== Database ======================================
# ServerHoster injects DATABASE_URL (mysql://user:pass@host:port/db) for the linked
# MySQL. MYSQL_* wins over it. With neither set the app falls back to
# localhost / root / empty password / db "aileadz" and logs a warning.
DATABASE_URL=
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=
# Local dev against a remote DB (python run.py opens an SSH tunnel; it exits unless
# SSH_HOST, SSH_USER and SSH_PASSWORD or SSH_PKEY are set):
# SSH_HOST=
# SSH_USER=
# SSH_PASSWORD=
# SSH_PKEY=
# SSH_PORT=22
# REMOTE_MYSQL_HOST=127.0.0.1
# REMOTE_MYSQL_PORT=3306
# Schema bootstrap (run.py before_request hooks; the worker does NOT run them):
# the "tables ensured" stamp (in the OS temp dir, keyed on the DDL fingerprint) is
# reused for this many seconds; 0 = run on every boot. FORCE=1 ignores the stamp,
# SKIP=1 skips the sync (test suites build the schema themselves).
# ENTERPRISE_TABLE_SYNC_TTL_SECONDS=21600
# ENTERPRISE_TABLE_SYNC_FORCE=1
# ENTERPRISE_TABLE_SYNC_SKIP=1
# Alembic only (migrations/env.py): a full SQLAlchemy URL, which must use the
# mysql+pymysql:// scheme (it wins over DATABASE_URL and MYSQL_*).
# ALEMBIC_DATABASE_URL=

# ============================== E-mail (required for any mail to leave) ========
# Nothing is sent until a server AND a sender resolve; otherwise sends are logged
# in email_log as skipped_no_backend. See docs/runbooks/EMAIL_SETUP.md.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
# MAIL_USE_SSL=1 (implicit SSL; it is also assumed when MAIL_PORT=465 and unset)
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender resolution: MAIL_DEFAULT_SENDER, else SMTP_FROM (+ SMTP_FROM_NAME), else
# MAIL_USERNAME. Verify with "Send test-mail" under Admin -> Systemstatus after
# every change.
MAIL_DEFAULT_SENDER=
# ServerHoster-style aliases, used when the MAIL_* equivalent is empty:
# SMTP_HOST= (or SMTP_SERVER=), SMTP_PORT=, SMTP_USER=, SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=

# ============================== Background worker =============================
# The in-request job runner is the default so a fresh deploy still sends mail and
# webhooks. Once the dedicated worker service (python drain_worker.py --loop) runs,
# set this to 0 on the WEB service so visitors never pay for background work.
SCHEDULER_OPPORTUNISTIC=1
# Seconds between worker passes (worker service only; --interval overrides; min 5)
OUTBOX_DRAIN_INTERVAL=60
# Legacy HTTP drain endpoint POST /api/v1/_internal/drain-outbox (disabled with 503
# while unset). The worker does not need it.
# OUTBOX_DRAIN_TOKEN=
# Fraction of /api/v1 requests that piggy-back a tiny outbox drain (default 0.05)
# OUTBOX_OPPORTUNISTIC_FRACTION=0.05

# ============================== Observability =================================
# json = one JSON object per log line with the request id
LOG_FORMAT=
# Error tracking (optional): create a Sentry project and paste the DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Shared cache across workers (optional; falls back to in-process if unreachable)
REDIS_URL=
# Detailed /readyz body for monitors (sent as the X-Health-Token header). Without
# it only a platform admin session sees details; the public gets {"status": ...}.
HEALTH_TOKEN=

# ============================== Support page ==================================
SUPPORT_EMAIL=support@futurematch.dk
# Shown only when set (the page never promises a phone line you do not staff)
SUPPORT_PHONE=
SUPPORT_HOURS=
SUPPORT_SLA=

# ============================== Catalog =======================================
# Daily shopify_sync job (also Admin -> Katalogadmin -> sync). It skips cleanly
# while SHOPIFY_STORE or SHOPIFY_ADMIN_TOKEN is unset. NEVER commit a token.
# SHOPIFY_STORE is the shop domain (e.g. mystore.myshopify.com).
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2024-10
# Raw catalog export written by the sync. Absolute, or relative to the app root.
# Default app1/shopify_products_all_pages.json (git-ignored).
CATALOG_SOURCE_FILE=
# 0 = do not embed new/imported products in the background after a catalog change
# (the 6-hourly catalog_embed job still does). Default 1.
# CATALOG_AUTO_EMBED=1
# Seconds the catalog file-signature stat is reused (default 5)
# CATALOG_SIGNATURE_TTL_SECONDS=5
# Concurrent summary workers in the offline app1/build_index.py (default 16)
# BUILD_INDEX_WORKERS=16

# ============================== SSO / secrets =================================
# Fernet key for SSO client secrets (falls back to a key derived from SECRET_KEY)
SSO_FERNET_KEY=
# Fernet key for stored TOTP secrets (falls back to a key derived from SECRET_KEY)
# TWOFA_FERNET_KEY=

# ============================== AI ============================================

# OPENAI_API_KEY is required in EVERY configuration, including AI_PROVIDER=anthropic:
# embeddings / RAG retrieval have no Anthropic equivalent and the catalog index is
# built with text-embedding-3-small.
OPENAI_API_KEY=

# --- AI provider toggle -------------------------------------------------------
# openai | anthropic | anthropic_shadow  (anthropic_shadow serves OpenAI and runs
# a sampled tool-less Claude comparison in the background). An admin can override
# this at runtime from /admin/ai-settings without a restart; the DB value wins
# over this env var. Only needed when AI_PROVIDER is anthropic or anthropic_shadow:
AI_PROVIDER=openai
ANTHROPIC_API_KEY=

# Both API keys above can instead be set from /admin/ai-settings, where they are
# stored Fernet-encrypted in the ai_secrets table and take precedence over
# these env vars. AI_SECRET_KEY is the encryption key for that storage: generate
# one with
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it the app falls back to deriving a key from SECRET_KEY (weaker, and
# rotating SECRET_KEY orphans stored keys); with neither set, the admin UI
# refuses to store a key rather than writing it unencrypted.
AI_SECRET_KEY=

# Models (also editable at /admin/ai-settings; the DB value wins)
AI_MAIN_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
ANTHROPIC_MAIN_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# quality | balanced | cost (admin-editable; default balanced)
# AI_MODEL_ROUTING=balanced
AI_RUNTIME=responses

# Claude-specific tuning (ignored when AI_PROVIDER=openai)
# Thinking tokens are charged against max_tokens and adaptive thinking is on by
# default, so the OpenAI tool-turn cap (320) is raised to this floor on Claude -
# otherwise a tool turn stops at max_tokens before emitting a tool_use block.
ANTHROPIC_MIN_MAX_TOKENS=4096
# Floor for ANSWER turns. Reasoning over long tool output (course search,
# profile analysis) spends thousands of thinking tokens before the first visible
# token, so AI_MAX_OUTPUT_TOKENS is far too tight on Claude and the answer stops
# mid-sentence. A ceiling is not a charge - only generated tokens are billed.
ANTHROPIC_ANSWER_MAX_TOKENS=16000
# output_config.effort replaces temperature (removed on current Claude models).
# Leave empty for the built-in tiering: low on tool turns / fast tier, high on
# main-tier final answers.
ANTHROPIC_EFFORT=
AI_ANTHROPIC_TIMEOUT_SECONDS=40
AI_ANTHROPIC_MAX_RETRIES=1
# Fraction of turns mirrored to Claude when AI_PROVIDER=anthropic_shadow.
AI_SHADOW_SAMPLE_RATE=0.1

# Token budgets (keep under the OpenAI org TPM limit; code defaults 36000 / 42000,
# older deploys pinned 20000 / 26000)
AI_MAX_INPUT_TOKENS=36000
AI_TPM_BUDGET=42000
# Per-turn system context (profile, memories, playbooks) is fitted by priority
# into this many tokens (ai_context_layers.py). 0/false on AI_CONTEXT_ASSEMBLER
# restores the legacy flat 1800-char cut.
AI_CONTEXT_MAX_TOKENS=10000
AI_CONTEXT_ASSEMBLER=1
AI_STEERING_PLACEMENT=trailing
# Code default 600
AI_MAX_OUTPUT_TOKENS=450
AI_MAX_TOOL_ITERATIONS=3
# Tool-deciding turns pin a low temperature for deterministic tool selection
# (empty value = use the API default). Token estimator chars/token divisor is
# tunable for Danish (code default 4.0).
AI_TOOL_TURN_TEMPERATURE=0.2
AI_TOKEN_CHARS_PER_TOKEN=3.5
# Optional token/recall tuning (default off - enable after an eval baseline confirms no regression)
AI_TRIM_TOOL_DESCRIPTIONS=off
AI_GROUNDING_DECOMPOUND=off

# Resilience
AI_RATE_LIMIT_RETRY_SECONDS=2.5
AI_RATE_LIMIT_COOLDOWN_SECONDS=90
AI_OPENAI_TIMEOUT_SECONDS=40

# Context (code defaults: AI_FEW_SHOT=compact, AI_SUMMARY_MODE=smart)
AI_FEW_SHOT=compact
AI_SUMMARY_MODE=rules
AI_TOOL_ROUTER_V2=1

# AI Tooler 2 (platform-control tools + confirm/progress UI) is GA and defaults to
# on; "off" is an opt-out kill switch that only reports the batch as disabled.
# AI_TOOLER2=on
# Live tool progress/finish events (existing) and final-answer capture (existing)
AI_LIVE_TOOL_EVENTS=1
AI_CAPTURE_FINAL=1

# RAG / embeddings
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1024
AI_RAG_CROSS_ENCODER=auto
AI_RERANK_MAX_CANDIDATES=4

# Observability (optional)
AI_TRACE_SAMPLE_RATE=1
# The worker sets this to 0 itself (drain_worker.py).
AI_WARMUP_ON_IMPORT=1

# Re-index note: after switching AI_EMBEDDING_MODEL / AI_EMBEDDING_DIMENSIONS,
# re-embed the catalog (docs/runbooks/CATALOG_REBUILD.md) and verify sample queries.

# Further optional AI knobs (all read in code, defaults shown; see docs/ai-framework.md):
# AI_LLM_ROUTER=1                 AI_LLM_ROUTER_TIMEOUT_SECONDS=4
# AI_MAX_TOOL_CALLS=12            AI_MAX_RUN_COST=0   AI_MAX_RUN_TOKENS=0 (0 = no cap)
# AI_MAX_TOOL_TURN_OUTPUT_TOKENS=320
# AI_RATE_LIMIT_BACKOFF_CAP_SECONDS=20
# AI_SESSION_SUMMARY_MODE=llm
# AI_MEMORY_BACKEND=auto          (sqlite = local dev fallback for the AI store)
# AI_USER_KNOWLEDGE=1             AI_USER_KNOWLEDGE_EMBEDDINGS=1   AI_HELP_KB=1
# AI_LEARNER_HR_CONTEXT=1         AI_LEARNER_HR_GOALS=1
# AI_PROFILE_AUTOSAVE=1           AI_PROFILER_HANDOFF_PCT=70   AI_PROFILE_CHECKINS=1
# AI_SEARCH_HARD_FILTERS=1        AI_FILTER_PAST_DATES=1
# AI_COST_MODEL_ENABLED=1         AI_USD_DKK=7.0   AI_CREDITS_PER_DKK=10
# VOICE_INPUT_ENABLED=1           VOICE_RATE_LIMIT=20   VOICE_RATE_WINDOW=300
# VOICE_WHISPER_MODEL=whisper-1

# -- Security & privacy (Part A) -----------------------------------------------
# Platform admins must enrol TOTP 2FA (1 = on). Only set 0 as a break-glass.
TWOFA_ENFORCE_ADMIN=1
TWOFA_ENFORCE_COMPANY_ADMIN=0
# Content-Security-Policy enforcement (0 = report-only break-glass) and HSTS.
CSP_ENFORCE=1
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=0
# Login lockout (defaults shown; per account, plus a per-IP failure ceiling)
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_IP_MAX_FAILURES=30
# Who is e-mailed when a user requests erasure (falls back to SUPPORT_EMAIL).
DSR_NOTIFY_EMAIL=
# Retention overrides, e.g. RETENTION_EMAIL_LOG_DAYS=90 (0/off disables a rule);
# rule names are in retention_service.POLICIES.
# RETENTION_<NAME>_DAYS=

# -- Performance / reports -----------------------------------------------------
# Date windows bounding heavy report scans, in days (defaults 90 / 365)
# REPORTS_WINDOW_DAYS=90
# USAGE_WINDOW_DAYS=365
# "Avanceret" ML analytics under Læringsanalyse (enterprise_analytics; off unless 1)
# ADVANCED_ANALYTICS_ENABLED=

# -- Dev / test only -----------------------------------------------------------
# Port for sandbox/run_sandbox.py (default 5001)
# SANDBOX_PORT=5001
# Keep CSRF enforcement on even under SANDBOX=1
# CSRF_IN_SANDBOX=1
# Enable the demo chat on non-local hosts (it is always on for localhost)
# FUTUREMATCH_ENABLE_DEMO_CHAT=1
# Nightly AI eval vendor-assistant account (GitHub Actions secrets; ai_eval/run_eval.py)
# EVAL_VENDOR_EMAIL=
# EVAL_VENDOR_PASSWORD=
